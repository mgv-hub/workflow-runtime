{
  "name": "workflow-runtime",
  "version": "1.0.0",
  "description": "General-purpose runtime for workflows, scheduling, state, events, expiration, and automated execution in Node.js",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./adapters/fs": {
      "types": "./dist/types/storage/fs-store.d.ts",
      "import": "./dist/esm/storage/fs-store.js",
      "require": "./dist/cjs/storage/fs-store.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/write-dist-package-jsons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests examples",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "example": "tsx",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "workflow",
    "runtime",
    "scheduler",
    "cron",
    "automation",
    "expiration",
    "ttl",
    "inactivity",
    "tasks",
    "queue",
    "events",
    "state",
    "lifecycle",
    "nodejs"
  ],
  "author": "mgv-hub",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.8.1",
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.4"
  }
}
